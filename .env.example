# =======================================================
# Pixel 12 OS — Production Environment Configuration
# =======================================================

# Port for web ingress (automatically set by Render / Cloud Run)
PORT=3000

# Node environment
NODE_ENV=production

# Server-Side Google Gemini AI Key for strategy, copywriting, post designs and proposal generation
# (Crucial: Keep on backend only. Never prefix with VITE_)
GEMINI_API_KEY=

# =======================================================
# Transactional Email Configuration (Pixel 12 OS Team Invitations)
# =======================================================
# Recommended provider: resend (or sendgrid / postmark)
EMAIL_PROVIDER=resend
# Transactional email sender address (e.g. Pixel 12 OS <team@pixel12.agency> or Resend onboarding)
EMAIL_FROM=Pixel 12 OS <onboarding@resend.dev>
# API Key for email delivery (Keep on backend only. e.g. re_xxxx or SG.xxxx)
EMAIL_API_KEY=

# Public App URL (Optional, defaults to automatic request host detection)
APP_URL=

